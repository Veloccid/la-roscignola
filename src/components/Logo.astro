---
// Logo ORIGINALE del cliente (public/logo/la-roscignola-logo.jpg, file non modificato).
// Il file è un JPG 728×275 con sfondo bianco: qui viene solo ritagliato via CSS
// e fuso con lo sfondo (mix-blend-mode: multiply) così il bianco non si vede sugli sfondi chiari.
// Sugli sfondi scuri usare `targa` per metterlo su una targhetta color avorio.
// Quando arriva un PNG trasparente o un SVG basta cambiare FILE e togliere il multiply.
interface Props {
  variante?: 'completo' | 'marchio';
  targa?: boolean;
  class?: string;
  titolo?: string;
}
const { variante = 'completo', targa = false, class: classe = '', titolo = 'La Roscignola' } = Astro.props;

const FILE = '/logo/la-roscignola-logo.jpg';
const W = 728;
const H = 275;
// zone di ritaglio nel file originale (pixel)
const RITAGLI = {
  completo: { x: 44, y: 64, w: 608, h: 160 }, // scritta ROSCIGNOLA con piuma e grappolo
  marchio: { x: 44, y: 64, w: 126, h: 140 }, // solo la R con la piuma
};
const r = RITAGLI[variante];
const stile = [
  `--rapporto:${r.w} / ${r.h}`,
  `--larghezza:${((W / r.w) * 100).toFixed(3)}%`,
  `--sx:${((-r.x / r.w) * 100).toFixed(3)}%`,
  `--su:${((-r.y / r.h) * 100).toFixed(3)}%`,
].join(';');
---

<span class:list={['logo', `logo--${variante}`, { 'logo--targa': targa }, classe]} style={stile} role="img" aria-label={titolo}>
  <span class="logo-finestra">
    <img src={FILE} alt="" width={W} height={H} decoding="async" />
  </span>
</span>

<style>
  .logo {
    display: block;
    border-radius: 10px;
  }
  .logo-finestra {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--rapporto);
  }
  .logo img {
    position: absolute;
    left: var(--sx);
    top: var(--su);
    width: var(--larghezza);
    max-width: none;
    height: auto;
    mix-blend-mode: multiply;
    /* schiarisce la texture grigia dell'angolo del file fino al bianco, senza modificare il file */
    filter: brightness(1.07) contrast(1.08);
    user-select: none;
    -webkit-user-drag: none;
  }
  .logo--targa {
    background: #fff;
    padding: 0.5em 0.8em;
    box-shadow: 0 6px 20px -10px rgba(0, 0, 0, 0.45);
  }
</style>
