---
// Loghi ORIGINALI del cliente (PNG trasparenti 1500×1500, non modificati), ritagliati solo via CSS.
//   completo vinaccia → /logo/logo-roscignola.png         (sfondi chiari)
//   completo bianco   → /logo/logo-roscignola-bianco.png  (sfondi scuri / foto)
//   marchio vinaccia  → /logo/r-roscignola.png            (la R con la piuma)
//   marchio bianco    → /logo/r-roscignola-bianca.png
interface Props {
  variante?: 'completo' | 'marchio';
  bianco?: boolean;
  class?: string;
  titolo?: string;
}
const { variante = 'completo', bianco = false, class: classe = '', titolo = 'La Roscignola' } = Astro.props;

const LATO = 1500;
const FILE = {
  completo: { vinaccia: '/logo/logo-roscignola.png', bianco: '/logo/logo-roscignola-bianco.png' },
  marchio: { vinaccia: '/logo/r-roscignola.png', bianco: '/logo/r-roscignola-bianca.png' },
};
// zone utili dentro il quadrato 1500×1500 (pixel), con un piccolo margine
const RITAGLI = {
  completo: { vinaccia: { x: 28, y: 582, w: 1420, h: 334 }, bianco: { x: 34, y: 590, w: 1420, h: 327 } },
  marchio: { vinaccia: { x: 88, y: 98, w: 1311, h: 1311 }, bianco: { x: 119, y: 130, w: 1253, h: 1239 } },
};
const colore = bianco ? 'bianco' : 'vinaccia';
const r = RITAGLI[variante][colore];
const stile = [
  `--rapporto:${r.w} / ${r.h}`,
  `--larghezza:${((LATO / r.w) * 100).toFixed(3)}%`,
  `--sx:${((-r.x / r.w) * 100).toFixed(3)}%`,
  `--su:${((-r.y / r.h) * 100).toFixed(3)}%`,
].join(';');
---

<span class:list={['logo', `logo--${variante}`, `logo--${colore}`, classe]} style={stile} role="img" aria-label={titolo}>
  <img src={FILE[variante][colore]} alt="" width={LATO} height={LATO} decoding="async" />
</span>

<style>
  .logo {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--rapporto);
  }
  .logo img {
    position: absolute;
    left: var(--sx);
    top: var(--su);
    width: var(--larghezza);
    max-width: none;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
