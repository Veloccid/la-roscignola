---
import Foto from './Foto.astro';
import type { Camera } from '../data/camere';
import { link } from '../temi';
interface Props {
  camera: Camera;
  tema: string;
  class?: string;
}
const { camera: c, tema, class: classe = '' } = Astro.props;
---

<article class:list={['scheda', classe]} id={c.id}>
  <Foto soggetto={c.nome} tipo="camera" tinta={c.tinta} rapporto="4 / 3" />
  <div class="scheda-testo">
    <p class="scheda-meta">{c.piano} · {c.mq} m² · fino a {c.ospiti} ospiti</p>
    <h3>{c.nome}</h3>
    <p>{c.breve}</p>
    <ul class="scheda-servizi">{c.servizi.slice(0, 3).map((s) => <li>{s}</li>)}</ul>
    <div class="scheda-piede">
      <p class="scheda-prezzo"><span>da</span> {c.prezzo}€ <span>/ notte</span></p>
      <a class="btn btn--vuoto" href={`${link(tema, 'disponibilita')}?camera=${c.id}`}>Vedi date libere</a>
    </div>
  </div>
</article>

<style>
  .scheda {
    background: var(--superficie);
    border-radius: calc(var(--raggio) + 4px);
    overflow: hidden;
    border: 1px solid var(--linea);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .scheda:hover {
    transform: translateY(-4px);
    box-shadow: var(--ombra);
  }
  .scheda :global(.foto) {
    --raggio-foto: 0;
  }
  .scheda-testo {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .scheda-meta {
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tenue);
    margin-bottom: 6px;
  }
  .scheda h3 {
    margin-bottom: 0.35em;
  }
  .scheda-servizi {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .scheda-servizi li {
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--avorio);
    border: 1px solid var(--linea);
  }
  .scheda-piede {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .scheda-prezzo {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.6rem;
    color: var(--bordeaux);
  }
  .scheda-prezzo span {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--tenue);
  }
  .scheda .btn {
    min-height: 42px;
    padding-inline: 1.1em;
    font-size: 0.85rem;
  }
</style>
