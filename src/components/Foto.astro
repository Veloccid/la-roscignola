---
// Segnaposto per le foto che arriveranno. Quando ci sono le foto vere, passare `src`.
interface Props {
  soggetto: string;
  tipo?: 'esterno' | 'camera' | 'colazione' | 'giardino' | 'dettaglio';
  tinta?: [string, string];
  src?: string;
  rapporto?: string;
  class?: string;
  etichetta?: boolean;
}
const {
  soggetto,
  tipo = 'esterno',
  tinta = ['#7A1F2B', '#B48F5A'],
  src,
  rapporto = '4 / 3',
  class: classe = '',
  etichetta = true,
} = Astro.props;
---

<figure class:list={['foto', classe]} style={`--a:${tinta[0]};--b:${tinta[1]};aspect-ratio:${rapporto}`}>
  {
    src ? (
      <img src={src} alt={soggetto} loading="lazy" />
    ) : (
      <>
        <svg class="foto-disegno" viewBox="0 0 200 140" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          {tipo === 'esterno' && (
            <>
              <path d="M40 112 V66 L100 30 L160 66 V112 Z" />
              <path d="M86 112 V84 h28 v28" />
              <rect x="56" y="74" width="18" height="18" />
              <rect x="126" y="74" width="18" height="18" />
              <path d="M20 112 h160" />
              <path d="M172 112 c-6 -18 -2 -34 6 -44 c8 10 12 26 6 44" />
              <path d="M28 112 c-8 -14 -4 -30 4 -38 c8 8 12 24 4 38" />
            </>
          )}
          {tipo === 'camera' && (
            <>
              <path d="M36 110 V78 h128 v32" />
              <path d="M36 92 h128" />
              <path d="M44 78 v-26 c0 -6 4 -8 10 -8 h92 c6 0 10 2 10 8 v26" />
              <rect x="56" y="62" width="34" height="14" rx="6" />
              <rect x="110" y="62" width="34" height="14" rx="6" />
              <path d="M30 110 h140" />
              <path d="M150 28 h16 v14 h-16 z" />
            </>
          )}
          {tipo === 'colazione' && (
            <>
              <path d="M62 70 h52 v18 c0 14 -12 24 -26 24 s-26 -10 -26 -24 z" />
              <path d="M114 76 c14 0 14 18 0 18" />
              <path d="M74 56 c-4 -6 4 -10 0 -16 M88 56 c-4 -6 4 -10 0 -16 M102 56 c-4 -6 4 -10 0 -16" />
              <ellipse cx="88" cy="114" rx="44" ry="6" />
              <path d="M140 112 c0 -14 8 -22 18 -22 s18 8 18 22 z" />
            </>
          )}
          {tipo === 'giardino' && (
            <>
              <path d="M100 116 V70" />
              <circle cx="100" cy="52" r="26" />
              <path d="M88 66 l12 10 l12 -12" />
              <path d="M20 116 h160" />
              <path d="M150 116 v-24 M140 92 h20" />
              <path d="M42 116 c0 -10 6 -16 12 -16 s12 6 12 16" />
            </>
          )}
          {tipo === 'dettaglio' && (
            <>
              <circle cx="100" cy="70" r="34" />
              <path d="M84 70 c8 -14 24 -14 32 0 c-8 14 -24 14 -32 0 z" />
            </>
          )}
        </svg>
        {etichetta && (
          <figcaption>
            <span>Foto in arrivo</span> {soggetto}
          </figcaption>
        )}
      </>
    )
  }
</figure>

<style>
  .foto {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--raggio-foto, var(--raggio));
    background:
      radial-gradient(120% 90% at 20% 10%, color-mix(in srgb, var(--b) 70%, white) 0%, transparent 60%),
      linear-gradient(150deg, var(--a), color-mix(in srgb, var(--a) 55%, var(--b)));
    color: rgba(255, 252, 247, 0.55);
    isolation: isolate;
  }
  .foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 6px 6px;
    z-index: -1;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .foto-disegno {
    position: absolute;
    inset: 12% 14% 22%;
    width: 72%;
    height: 66%;
  }
  figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    right: 12px;
    font: 400 0.82rem/1.3 var(--sans);
    color: rgba(255, 252, 247, 0.92);
  }
  figcaption span {
    display: inline-block;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.22);
    padding: 3px 7px;
    border-radius: 4px;
    margin-right: 4px;
  }
</style>
