---
import Layout from '../../layouts/Layout.astro';
import { SITO } from '../../config';
import { percorsiTemi, type Tema } from '../../temi';
export function getStaticPaths() {
  return percorsiTemi();
}
const { tema } = Astro.props as { tema: Tema };
---

<Layout tema={tema} titolo="Privacy e cookie">
  <section class="sezione contenitore testo-legale">
    <span class="provvisorio">Da completare con un professionista</span>
    <h1>Privacy e cookie</h1>
    <p>Qui andrà l’informativa privacy e cookie del B&B (titolare del trattamento, dati raccolti con le prenotazioni, pagamenti tramite Stripe, conservazione, diritti dell’ospite).</p>
    <p class="tenue">{SITO.nome} · {SITO.piva} · {SITO.cin}</p>
  </section>
</Layout>

<style>
  .testo-legale {
    max-width: 760px;
  }
  .testo-legale h1 {
    margin-top: 16px;
  }
</style>
