---
import Layout from '../../layouts/Layout.astro';
import { percorsiTemi, type Tema } from '../../temi';
import Essenziale from '../../proposte/essenziale/Home.astro';
import Bordeaux from '../../proposte/bordeaux/Home.astro';
import Centrale from '../../proposte/centrale/Home.astro';
import Salvia from '../../proposte/salvia/Home.astro';
import Meta from '../../proposte/meta/Home.astro';

export function getStaticPaths() {
  return percorsiTemi();
}
const { tema } = Astro.props as { tema: Tema };
const HOME: Record<string, any> = { essenziale: Essenziale, bordeaux: Bordeaux, centrale: Centrale, salvia: Salvia, meta: Meta };
const Home = HOME[tema.id];
const trasparente = ['bordeaux', 'salvia'].includes(tema.id);
---

<Layout tema={tema} trasparente={trasparente}>
  <Home tema={tema.id} />
</Layout>
