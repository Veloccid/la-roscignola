---
import Layout from '../../layouts/Layout.astro';
import { SITO } from '../../config';
import { REGOLE } from '../../data/camere';
import { percorsiTemi, type Tema } from '../../temi';
export function getStaticPaths() {
  return percorsiTemi();
}
const { tema } = Astro.props as { tema: Tema };
---

<Layout tema={tema} titolo="Condizioni di prenotazione">
  <section class="sezione contenitore testo-legale">
    <span class="provvisorio">Da completare con un professionista</span>
    <h1>Condizioni di prenotazione</h1>
    <h2>Regole della casa</h2>
    <ul>{REGOLE.map((r) => <li>{r}</li>)}</ul>
    <h2>Pagamento e cancellazione</h2>
    <p>Prenotando dal sito si paga online al momento della prenotazione. Politica di cancellazione e rimborso, eventuale tassa di soggiorno e deposito: da definire con il proprietario.</p>
    <p class="tenue">{SITO.nome} · {SITO.piva} · {SITO.cin}</p>
  </section>
</Layout>

<style>
  .testo-legale {
    max-width: 760px;
  }
  .testo-legale h1 {
    margin-top: 16px;
  }
</style>
