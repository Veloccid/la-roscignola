---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Pagina non trovata · La Roscignola</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <main class="contenitore nf">
      <Logo variante="marchio" class="nf-logo" />
      <h1>L’usignolo è volato via</h1>
      <p class="tenue">Questa pagina non esiste. Torna all’inizio e trova la tua camera.</p>
      <a class="btn" href="/">Torna all’inizio</a>
    </main>
  </body>
</html>

<style>
  .nf {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: 8px;
  }
  .nf :global(.nf-logo) {
    width: 140px;
    color: var(--bordeaux);
    margin-bottom: 20px;
  }
</style>
