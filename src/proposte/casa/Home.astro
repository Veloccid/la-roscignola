---
import Foto from '../../components/Foto.astro';
import Calendario from '../../components/Calendario.astro';
import BloccoContatti from '../../components/BloccoContatti.astro';
import { CAMERE, SERVIZI_CASA } from '../../data/camere';
import { link } from '../../temi';
const { tema } = Astro.props;
// posizione dei punti cliccabili sul disegno (in percentuale)
const punti: Record<string, { x: number; y: number }> = {
  usignolo: { x: 38, y: 46 },
  glicine: { x: 62, y: 46 },
  uliveto: { x: 38, y: 77 },
  pergola: { x: 84, y: 76 },
};
const extra = [
  { id: 'giardino', nome: 'Il giardino', testo: SERVIZI_CASA[1].testo, x: 12, y: 61 },
  { id: 'colazione', nome: 'La colazione', testo: SERVIZI_CASA[0].testo, x: 55, y: 90 },
];
---

<section class="contenitore intro">
  <span class="occhiello">Entra pure</span>
  <h1>Tocca una finestra <span class="corsivo">e affacciati</span></h1>
  <p class="tenue">Ogni finestra è una camera. Toccala per vederla, sapere quanto costa e controllare i giorni liberi.</p>
</section>

<section class="contenitore">
  <div class="casa">
    <svg viewBox="0 0 1000 620" class="disegno" aria-hidden="true">
      <defs>
        <linearGradient id="cielo" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#F3E7D7" /><stop offset="1" stop-color="#F6F0E7" />
        </linearGradient>
      </defs>
      <rect width="1000" height="620" fill="url(#cielo)" />
      <circle cx="840" cy="110" r="46" fill="#EBD3A8" />
      <!-- prato -->
      <path d="M0 560 C 250 540, 750 540, 1000 560 V620 H0 Z" fill="#C9D0B8" />
      <!-- albero -->
      <path d="M120 560 V420" stroke="#5c4a3c" stroke-width="10" />
      <circle cx="120" cy="380" r="70" fill="#7D8A6A" /><circle cx="80" cy="410" r="42" fill="#8A976F" /><circle cx="160" cy="408" r="46" fill="#6F7C5E" />
      <!-- casa -->
      <rect x="250" y="190" width="500" height="370" fill="#EADBC6" stroke="#7A1F2B" stroke-width="3" />
      <path d="M225 196 L500 70 L775 196 Z" fill="#B65A47" stroke="#7A1F2B" stroke-width="3" stroke-linejoin="round" />
      <path d="M250 370 H750" stroke="#7A1F2B" stroke-width="2" opacity=".35" />
      <!-- pergola -->
      <path d="M750 430 H930 M760 430 V560 M920 430 V560 M800 430 V560 M880 430 V560" stroke="#8a6a44" stroke-width="6" />
      <path d="M745 422 C 790 400, 840 440, 935 418" stroke="#7D8A6A" stroke-width="16" stroke-linecap="round" fill="none" opacity=".8" />
      <!-- finestre piano primo -->
      <g fill="#F6F0E7" stroke="#7A1F2B" stroke-width="3">
        <path d="M330 345 V275 a50 50 0 0 1 100 0 V345 Z" />
        <rect x="570" y="225" width="100" height="120" />
        <rect x="330" y="400" width="100" height="160" />
        <rect x="460" y="430" width="80" height="130" />
        <rect x="610" y="410" width="100" height="100" />
      </g>
      <!-- balcone usignolo -->
      <path d="M318 345 H442 V372 H318 Z M330 345 V372 M346 345 V372 M362 345 V372 M378 345 V372 M394 345 V372 M410 345 V372 M426 345 V372" stroke="#7A1F2B" stroke-width="2.5" fill="none" />
      <!-- glicine -->
      <g fill="#9B7DB0" opacity=".85">
        <ellipse cx="560" cy="215" rx="16" ry="10" /><ellipse cx="590" cy="208" rx="18" ry="11" /><ellipse cx="625" cy="212" rx="16" ry="10" />
        <ellipse cx="660" cy="210" rx="18" ry="11" /><ellipse cx="690" cy="220" rx="14" ry="9" />
        <path d="M580 220 q4 30 -2 50 M620 220 q6 30 0 56 M660 222 q-4 28 2 46" stroke="#9B7DB0" stroke-width="6" fill="none" stroke-linecap="round" />
      </g>
      <!-- porta -->
      <path d="M460 430 a40 40 0 0 1 80 0" fill="#7A1F2B" />
      <circle cx="527" cy="500" r="4" fill="#7A1F2B" />
      <!-- uccellino sul tetto -->
      <g transform="translate(470 58)" fill="#7A1F2B"><ellipse cx="12" cy="10" rx="13" ry="8" /><circle cx="24" cy="4" r="6" /><path d="M29 4 l9 2 l-9 2z" /><path d="M0 10 l-10 6 l12 -2z" /></g>
      <!-- tavolino colazione -->
      <path d="M520 555 v-30 M580 555 v-30 M505 525 h90" stroke="#5c4a3c" stroke-width="5" />
      <path d="M538 515 h20 v8 h-20z" fill="#7A1F2B" />
    </svg>

    {
      CAMERE.map((c) => (
        <button type="button" class="punto" style={`left:${punti[c.id].x}%;top:${punti[c.id].y}%`} data-apri={c.id}>
          <span class="punto-pallino"></span>
          <span class="punto-nome">{c.nome.replace('Camera ', '')}</span>
        </button>
      ))
    }
    {
      extra.map((e) => (
        <button type="button" class="punto punto--extra" style={`left:${e.x}%;top:${e.y}%`} data-apri={e.id}>
          <span class="punto-pallino"></span>
          <span class="punto-nome">{e.nome}</span>
        </button>
      ))
    }
  </div>
  <p class="nota tenue">Disegno provvisorio: quando arrivano le foto può diventare la foto vera della facciata con i punti sopra.</p>
</section>

{
  CAMERE.map((c) => (
    <dialog class="finestra" id={`d-${c.id}`}>
      <button type="button" class="chiudi" aria-label="Chiudi">×</button>
      <Foto soggetto={c.nome} tipo="camera" tinta={c.tinta} rapporto="16 / 9" />
      <div class="finestra-testo">
        <p class="meta">{c.piano} · {c.mq} m² · {c.letti}</p>
        <h2>{c.nome}</h2>
        <p>{c.descrizione}</p>
        <div class="finestra-piede">
          <span class="prezzo">da {c.prezzo}€ <small>/ notte</small></span>
          <a class="btn" href={`${link(tema, 'disponibilita')}?camera=${c.id}`}>Vedi date libere</a>
        </div>
      </div>
    </dialog>
  ))
}
{
  extra.map((e) => (
    <dialog class="finestra" id={`d-${e.id}`}>
      <button type="button" class="chiudi" aria-label="Chiudi">×</button>
      <Foto soggetto={e.nome} tipo={e.id === 'giardino' ? 'giardino' : 'colazione'} tinta={['#7D8A6A', '#E4D4BD']} rapporto="16 / 9" />
      <div class="finestra-testo">
        <h2>{e.nome}</h2>
        <p>{e.testo}</p>
      </div>
    </dialog>
  ))
}

<section class="sezione contenitore">
  <h2>I giorni liberi</h2>
  <Calendario tema={tema} />
</section>

<BloccoContatti tema={tema} />

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-apri]').forEach((b) =>
    b.addEventListener('click', () => (document.getElementById('d-' + b.dataset.apri) as HTMLDialogElement)?.showModal()),
  );
  document.querySelectorAll<HTMLDialogElement>('dialog.finestra').forEach((d) =>
    d.addEventListener('click', (e) => {
      if (e.target === d || (e.target as HTMLElement).closest('.chiudi')) d.close();
    }),
  );
</script>

<style>
  .intro {
    padding-block: clamp(32px, 5vw, 64px) 24px;
    max-width: 820px;
    margin-left: max(0px, calc((100vw - var(--max)) / 2));
  }
  .casa {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--linea);
    box-shadow: var(--ombra);
  }
  .disegno {
    display: block;
    width: 100%;
    height: auto;
  }
  .punto {
    position: absolute;
    transform: translate(-50%, -50%);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    display: grid;
    justify-items: center;
    gap: 4px;
  }
  .punto-pallino {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--bordeaux);
    border: 3px solid var(--avorio);
    box-shadow: 0 0 0 0 rgba(122, 31, 43, 0.5);
    animation: pulsa 2.2s infinite;
  }
  .punto--extra .punto-pallino {
    background: var(--salvia);
    animation: none;
  }
  .punto-nome {
    font: 500 0.78rem/1 var(--sans);
    background: var(--avorio);
    color: var(--bordeaux);
    padding: 5px 9px;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }
  .punto:hover .punto-pallino {
    transform: scale(1.15);
  }
  @keyframes pulsa {
    70% {
      box-shadow: 0 0 0 14px rgba(122, 31, 43, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(122, 31, 43, 0);
    }
  }
  @media (max-width: 600px) {
    .punto-pallino {
      width: 22px;
      height: 22px;
    }
    .punto-nome {
      font-size: 0.64rem;
      padding: 3px 6px;
    }
  }
  .nota {
    font-size: 0.82rem;
    margin-top: 10px;
  }
  .finestra {
    border: 0;
    padding: 0;
    border-radius: 20px;
    width: min(620px, calc(100vw - 24px));
    max-height: calc(100vh - 24px);
    overflow: auto;
    background: var(--avorio);
    color: var(--testo);
  }
  .finestra::backdrop {
    background: rgba(42, 28, 25, 0.55);
  }
  .finestra :global(.foto) {
    --raggio-foto: 0;
  }
  .finestra[open] {
    animation: apri 0.35s ease;
  }
  @keyframes apri {
    from {
      transform: scale(0.94);
      opacity: 0;
    }
  }
  .chiudi {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 0;
    background: var(--avorio);
    font-size: 1.4rem;
    cursor: pointer;
  }
  .finestra-testo {
    padding: 22px 24px 26px;
  }
  .meta {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tenue);
  }
  .finestra-piede {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .prezzo {
    font-family: var(--serif);
    font-size: 1.8rem;
    color: var(--bordeaux);
  }
  .prezzo small {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--tenue);
  }
</style>
