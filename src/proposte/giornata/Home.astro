---
import Foto from '../../components/Foto.astro';
import SchedaCamera from '../../components/SchedaCamera.astro';
import Calendario from '../../components/Calendario.astro';
import BloccoContatti from '../../components/BloccoContatti.astro';
import { CAMERE } from '../../data/camere';
import { link } from '../../temi';
const { tema } = Astro.props;
const momenti = [
  { ora: '6:30', titolo: 'Il canto', testo: 'Prima della sveglia, dalla finestra: l’usignolo che dà il nome alla casa.', tipo: 'giardino' },
  { ora: '8:30', titolo: 'La colazione', testo: 'Torte del giorno, marmellate di casa e caffè. Sotto il pergolato, se c’è il sole.', tipo: 'colazione' },
  { ora: '11:00', titolo: 'In giro', testo: 'Ti diamo i nostri posti preferiti: borghi, sentieri, la trattoria giusta. Da completare con i dintorni veri.', tipo: 'esterno' },
  { ora: '18:30', titolo: 'In giardino', testo: 'Un bicchiere sulle sdraio mentre il cielo diventa arancione dietro gli ulivi.', tipo: 'giardino' },
  { ora: '22:30', titolo: 'Buonanotte', testo: 'Silenzio vero, lenzuola fresche, buio di campagna. Domattina si ricomincia.', tipo: 'camera' },
] as const;
---

<section class="giorno" data-giorno>
  <div class="cielo">
    <div class="astri" aria-hidden="true">
      <span class="sole"></span>
      <span class="luna"></span>
      {Array.from({ length: 30 }, (_, i) => <i style={`--x:${(i * 37) % 100}%;--y:${(i * 53) % 55}%;--s:${1 + (i % 3)}px`}></i>)}
    </div>
    <svg class="orizzonte" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 140 C 200 110, 400 150, 600 120 S 1000 100, 1200 130 V200 H0 Z" class="colle1" />
      <path d="M0 170 C 300 150, 600 180, 900 160 S 1100 165, 1200 170 V200 H0 Z" class="colle2" />
      <g class="ulivi">
        <circle cx="180" cy="150" r="22" /><rect x="177" y="160" width="6" height="22" />
        <circle cx="240" cy="155" r="16" /><rect x="237" y="163" width="5" height="18" />
        <circle cx="980" cy="148" r="20" /><rect x="977" y="158" width="6" height="22" />
      </g>
    </svg>
    <div class="orologio" aria-hidden="true"><span class="ora">6:30</span><span class="sotto">una giornata alla Roscignola</span></div>
  </div>

  <ol class="momenti contenitore">
    {
      momenti.map((m) => (
        <li class="momento" data-ora={m.ora}>
          <div class="momento-card">
            <Foto soggetto={m.titolo} tipo={m.tipo} tinta={['#7A1F2B', '#B48F5A']} rapporto="16 / 10" />
            <div class="momento-testo">
              <span class="momento-ora">{m.ora}</span>
              <h2>{m.titolo}</h2>
              <p>{m.testo}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<section class="sezione contenitore">
  <span class="occhiello">Dove dormire</span>
  <h2>Quattro camere per la tua giornata</h2>
  <div class="griglia camere">{CAMERE.map((c) => <SchedaCamera camera={c} tema={tema} class="rivela" />)}</div>
</section>

<section class="sezione cal-sez">
  <div class="contenitore">
    <h2>Scegli quante giornate</h2>
    <Calendario tema={tema} />
    <p class="ancora"><a class="btn" href={link(tema, 'disponibilita')}>Apri il calendario completo</a></p>
  </div>
</section>

<BloccoContatti tema={tema} />

<script>
  const g = document.querySelector<HTMLElement>('[data-giorno]');
  if (g) {
    // colori del cielo: alba, mattina, mezzogiorno, tramonto, notte
    const tappe: [number, number[], number[], number[]][] = [
      [0, [233, 176, 168], [246, 214, 190], [42, 28, 25]],
      [0.22, [212, 226, 232], [246, 240, 231], [42, 28, 25]],
      [0.5, [196, 220, 234], [250, 246, 238], [42, 28, 25]],
      [0.75, [180, 90, 70], [232, 170, 100], [246, 240, 231]],
      [1, [26, 14, 30], [70, 20, 34], [246, 240, 231]],
    ];
    const mix = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
    const rgb = (c: number[]) => `rgb(${c.join(',')})`;
    const ora = g.querySelector('.ora')!;
    const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const momenti = [...g.querySelectorAll<HTMLElement>('.momento')];
    const aggiorna = () => {
      const r = g.getBoundingClientRect();
      const tot = g.offsetHeight - innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / tot));
      let i = 0;
      while (i < tappe.length - 2 && p > tappe[i + 1][0]) i++;
      const [p0, a0, b0, t0] = tappe[i];
      const [p1, a1, b1, t1] = tappe[i + 1];
      const t = Math.min(1, Math.max(0, (p - p0) / (p1 - p0)));
      g.style.setProperty('--alto', rgb(mix(a0, a1, t)));
      g.style.setProperty('--basso', rgb(mix(b0, b1, t)));
      g.style.setProperty('--ink', rgb(mix(t0, t1, t)));
      g.style.setProperty('--p', p.toFixed(4));
      g.classList.toggle('notte', p > 0.8);
      let vicino = momenti[0];
      let min = Infinity;
      momenti.forEach((m) => {
        const b = m.getBoundingClientRect();
        const c = (b.top + b.height / 2 - innerHeight / 2) / innerHeight;
        if (Math.abs(c) < min) {
          min = Math.abs(c);
          vicino = m;
        }
        m.style.setProperty('--c', ridotto ? '0' : Math.max(-1, Math.min(1, c)).toFixed(3));
      });
      ora.textContent = vicino.dataset.ora || '';
    };
    aggiorna();
    addEventListener('scroll', () => requestAnimationFrame(aggiorna), { passive: true });
    addEventListener('resize', aggiorna);
  }
</script>

<style>
  .giorno {
    --alto: rgb(233, 176, 168);
    --basso: rgb(246, 214, 190);
    --ink: var(--testo);
    --p: 0;
    position: relative;
    color: var(--ink);
  }
  .cielo {
    position: sticky;
    top: 72px;
    height: calc(100vh - 72px);
    height: calc(100svh - 72px);
    background: linear-gradient(180deg, var(--alto), var(--basso));
    overflow: hidden;
    z-index: 0;
  }
  .astri {
    position: absolute;
    inset: 0;
  }
  .sole,
  .luna {
    position: absolute;
    width: clamp(70px, 10vw, 120px);
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .sole {
    background: radial-gradient(circle, #fff3d6 0 40%, #f6c77b 70%, rgba(246, 199, 123, 0) 71%);
    box-shadow: 0 0 80px 30px rgba(255, 220, 160, 0.45);
    left: calc(8% + var(--p) * 100%);
    top: calc(70% - sin(var(--p) * 3.6rad) * 58%);
    opacity: calc(1 - clamp(0, (var(--p) - 0.82) * 8, 1));
  }
  .luna {
    width: clamp(46px, 6vw, 70px);
    background: radial-gradient(circle at 35% 35%, #fbf6ea, #ddd2bd);
    box-shadow: 0 0 40px 6px rgba(251, 246, 234, 0.25);
    right: 14%;
    top: calc(40% - clamp(0, (var(--p) - 0.78) * 5, 1) * 26%);
    opacity: clamp(0, (var(--p) - 0.78) * 5, 1);
  }
  .astri i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: #fbf6ea;
    opacity: clamp(0, (var(--p) - 0.82) * 6, 0.9);
  }
  .orizzonte {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 26%;
  }
  .colle1 {
    fill: color-mix(in srgb, #7d8a6a calc(100% - var(--p) * 60%), #1a0e1e);
  }
  .colle2 {
    fill: color-mix(in srgb, #5f6d4e calc(100% - var(--p) * 60%), #12080f);
  }
  .ulivi {
    fill: color-mix(in srgb, #4d5a3e calc(100% - var(--p) * 60%), #0d060b);
  }
  .orologio {
    position: absolute;
    top: 20px;
    left: var(--gutter);
    display: grid;
  }
  .ora {
    font-family: var(--serif);
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .sotto {
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .momenti {
    list-style: none;
    margin: calc(-100vh + 72px) auto 0;
    margin-top: calc(-100svh + 72px);
    position: relative;
    z-index: 1;
    padding-top: 55vh;
    padding-bottom: 30vh;
    display: grid;
    gap: 40vh;
  }
  .momento {
    display: flex;
    justify-content: flex-end;
  }
  .momento:nth-child(even) {
    justify-content: flex-start;
  }
  .momento-card {
    width: min(440px, 100%);
    background: color-mix(in srgb, var(--avorio) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--testo);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.5);
    opacity: calc(1 - max(var(--c, 0), calc(var(--c, 0) * -1)) * 0.9);
    transform: translateY(calc(var(--c, 0) * 40px)) scale(calc(1 - max(var(--c, 0), calc(var(--c, 0) * -1)) * 0.06));
  }
  .momento-card :global(.foto) {
    --raggio-foto: 0;
  }
  .momento-testo {
    padding: 18px 22px 22px;
  }
  .momento-ora {
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    color: var(--bordeaux);
    font-weight: 500;
  }
  .momento h2 {
    font-size: 1.9rem;
    margin: 4px 0 8px;
  }
  .momento p {
    margin: 0;
    color: var(--tenue);
  }
  .camere {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin-top: 24px;
  }
  .cal-sez {
    background: var(--sabbia);
  }
  .ancora {
    margin-top: 20px;
  }
</style>
