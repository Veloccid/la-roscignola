---
import Logo from '../../components/Logo.astro';
import Foto from '../../components/Foto.astro';
import Calendario from '../../components/Calendario.astro';
import BloccoContatti from '../../components/BloccoContatti.astro';
import { CAMERE } from '../../data/camere';
import { link } from '../../temi';
const { tema } = Astro.props;
const parole = ['Ascolta.', 'All’alba,', 'in giardino,', 'canta l’usignolo.'];
---

<section class="scena" data-scena>
  <div class="scena-fissa">
    <div class="sfondo-foto" aria-hidden="true"><img src="/foto/piscina-colline.jpg" alt="" /></div>
    <div class="note" aria-hidden="true">
      {Array.from({ length: 14 }, (_, i) => <i style={`--i:${i}`}></i>)}
    </div>
    <div class="marchio-wrap">
      <Logo variante="marchio" class="marchio" titolo="La Roscignola" targa />
    </div>
    <p class="parole" aria-label={parole.join(' ')}>
      {parole.map((w, i) => <span style={`--i:${i}`} aria-hidden="true">{w}</span>)}
    </p>
    <div class="finale">
      <div class="scrittura"><Logo class="parola" targa /></div>
      <p>Bed & Breakfast · piscina e giardino tra gli ulivi</p>
      <a class="btn" href={link(tema, 'disponibilita')}>Scegli le tue date</a>
    </div>
    <div class="scorri" aria-hidden="true">Scorri</div>
  </div>
</section>

<section class="sezione contenitore intro">
  <span class="occhiello">La casa</span>
  <h2>Un nome che è un canto</h2>
  <p>
    Roscignola è l’usignolo nel dialetto di qui. Lo trovi nel logo, sulla piuma della R, e lo senti davvero al mattino dalle finestre.
    Camere tranquille, una piscina tra gli ulivi e il tempo che rallenta. <span class="provvisorio">Testo provvisorio</span>
  </p>
</section>

<section class="contenitore camere">
  {
    CAMERE.map((c, i) => (
      <article class="cam rivela" style={`--d:${i * 80}ms`}>
        <svg class="piuma" viewBox="0 0 200 40" aria-hidden="true">
          <path d="M2 30 C 60 30, 120 4, 198 8" />
        </svg>
        <Foto soggetto={c.nome} tipo="camera" tinta={c.tinta} src={c.foto} rapporto="3 / 4" />
        <h3>{c.nome}</h3>
        <p class="tenue">{c.breve}</p>
        <a href={`${link(tema, 'disponibilita')}?camera=${c.id}`}>da {c.prezzo}€ · date libere →</a>
      </article>
    ))
  }
</section>

<section class="sezione contenitore">
  <h2>Quando vieni ad ascoltarlo?</h2>
  <Calendario tema={tema} />
</section>

<BloccoContatti tema={tema} />

<script>
  const scene = document.querySelectorAll<HTMLElement>('[data-scena]');
  const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function aggiorna() {
    scene.forEach((s) => {
      const r = s.getBoundingClientRect();
      const tot = s.offsetHeight - innerHeight;
      const p = ridotto ? 1 : Math.min(1, Math.max(0, -r.top / tot));
      s.style.setProperty('--p', p.toFixed(4));
    });
  }
  aggiorna();
  addEventListener('scroll', () => requestAnimationFrame(aggiorna), { passive: true });
  addEventListener('resize', aggiorna);
</script>

<style>
  .scena {
    --p: 0;
    height: 320vh;
    position: relative;
    background: var(--avorio);
  }
  .scena-fissa {
    position: sticky;
    top: 72px;
    height: calc(100vh - 72px);
    height: calc(100svh - 72px);
    overflow: hidden;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 50% at 50% calc(30% + var(--p) * 30%), rgba(180, 143, 90, calc(0.08 + var(--p) * 0.2)), transparent 70%),
      linear-gradient(180deg, var(--avorio), var(--sabbia));
  }
  .sfondo-foto {
    position: absolute;
    inset: 0;
    opacity: calc(clamp(0, (var(--p) - 0.7) * 4, 1) * 0.22);
  }
  .sfondo-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.35) saturate(0.8);
    transform: scale(calc(1.15 - var(--p) * 0.15));
  }
  .marchio-wrap {
    position: absolute;
    width: min(260px, 46vw);
    top: 44%;
    left: 50%;
    transform: translate(-50%, -50%) scale(calc(0.85 + clamp(0, var(--p) * 4, 1) * 0.15));
    opacity: calc(clamp(0, 0.25 + var(--p) * 5, 1) - clamp(0, (var(--p) - 0.6) * 6, 1));
  }
  .marchio-wrap :global(.marchio) {
    width: 100%;
    padding: 18px 22px;
    border-radius: 18px;
  }
  /* la piuma della R si “scrive” dal basso verso l’alto */
  .marchio-wrap :global(.logo-finestra) {
    clip-path: inset(calc((1 - clamp(0, 0.2 + var(--p) * 3.2, 1)) * 100%) 0 0 0);
  }
  .parole {
    position: absolute;
    bottom: 14%;
    left: 0;
    right: 0;
    text-align: center;
    margin: 0;
    padding-inline: 16px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.6rem, 4.2vw, 3rem);
    color: var(--bordeaux);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.35em;
    opacity: calc(1 - clamp(0, (var(--p) - 0.62) * 8, 1));
  }
  .parole span {
    opacity: clamp(0.1, (var(--p) * 10 - var(--i) * 1.3 - 0.4), 1);
    transform: translateY(calc((1 - clamp(0, var(--p) * 10 - var(--i) * 1.3 - 0.4, 1)) * 14px));
  }
  .finale {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 18px;
    padding-inline: 16px;
    opacity: clamp(0, (var(--p) - 0.68) * 6, 1);
    pointer-events: none;
  }
  .scena[style*='--p: 1'] .finale,
  .scena[style*='--p: 0.9'] .finale,
  .scena[style*='--p: 0.8'] .finale {
    pointer-events: auto;
  }
  .scrittura {
    width: min(640px, 86vw);
    /* il logo si scrive da sinistra a destra */
    clip-path: inset(0 calc((1 - clamp(0, (var(--p) - 0.68) * 4, 1)) * 100%) 0 0);
  }
  .scrittura :global(.parola) {
    width: 100%;
    padding: clamp(14px, 3vw, 28px) clamp(18px, 4vw, 40px);
    border-radius: 18px;
  }
  .finale p {
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--tenue);
    margin: 0;
  }
  .note i {
    position: absolute;
    left: calc(8% + var(--i) * 6.4%);
    bottom: calc(-10% + var(--p) * (60% + var(--i) * 4%));
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--oro);
    opacity: calc(0.15 + var(--p) * 0.45);
  }
  .note i:nth-child(3n) {
    width: 3px;
    height: 3px;
  }
  .scorri {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bordeaux);
    opacity: calc(0.7 - var(--p) * 4);
  }
  .scorri::after {
    content: '';
    display: block;
    width: 1px;
    height: 34px;
    margin: 8px auto 0;
    background: currentColor;
    animation: giu 1.8s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes giu {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .intro {
    max-width: 760px;
    text-align: center;
  }
  .intro p {
    font-size: 1.15rem;
  }
  .camere {
    display: grid;
    gap: 28px;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .cam {
    transition-delay: var(--d);
  }
  .cam:nth-child(even) {
    margin-top: 48px;
  }
  .piuma {
    width: 70%;
    height: 22px;
    fill: none;
    stroke: var(--oro);
    stroke-width: 1.3;
    margin-bottom: 8px;
  }
  .cam h3 {
    margin-top: 16px;
  }
  .cam a {
    color: var(--bordeaux);
    font-weight: 500;
    font-size: 0.92rem;
  }
  @media (max-width: 600px) {
    .cam:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
