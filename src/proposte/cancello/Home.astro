---
import SchedaCamera from '../../components/SchedaCamera.astro';
import Calendario from '../../components/Calendario.astro';
import BloccoContatti from '../../components/BloccoContatti.astro';
import { CAMERE } from '../../data/camere';
import { link } from '../../temi';
const { tema } = Astro.props;
const tappe = [
  { n: '01', titolo: 'Il cancello', testo: 'Una stradina, il cancello in ferro e il nome sulla targa. Parcheggi dentro, senza pensieri.', fondo: '#E4D4BD' },
  { n: '02', titolo: 'Il giardino', testo: 'Ulivi, prato e sdraio all’ombra. È qui che al mattino canta l’usignolo.', fondo: '#DFE3D4' },
  { n: '03', titolo: 'La tua camera', testo: 'Lenzuola fresche, bagno privato, finestre sul verde. Quattro stanze, ognuna diversa.', fondo: '#F1E4DD' },
  { n: '04', titolo: 'La colazione', testo: 'Torte del giorno, marmellate di casa, caffè come piace a te. Sotto il pergolato, se c’è il sole.', fondo: '#F3E7D0' },
];
---

<section class="percorso" data-percorso>
  <div class="percorso-fisso">
    <div class="sfondi">{tappe.map((t, i) => <div class="sfondo" data-i={i} style={`background:${t.fondo}`}></div>)}</div>

    <div class="quadri" aria-hidden="true">
      <svg class="quadro" data-i="0" viewBox="0 0 400 300">
        <path d="M60 280 V110 M340 280 V110" stroke-width="5" />
        <circle cx="60" cy="100" r="9" /><circle cx="340" cy="100" r="9" />
        <g class="anta-sx"><path d="M66 270 H198 V150 C 160 120, 110 120, 66 140 Z" /><path d="M88 270 V138 M110 270 V128 M132 270 V124 M154 270 V125 M176 270 V134" /></g>
        <g class="anta-dx"><path d="M334 270 H202 V150 C 240 120, 290 120, 334 140 Z" /><path d="M312 270 V138 M290 270 V128 M268 270 V124 M246 270 V125 M224 270 V134" /></g>
        <rect x="160" y="168" width="80" height="22" rx="3" class="targa" />
        <text x="200" y="183" text-anchor="middle" class="targa-t">LA ROSCIGNOLA</text>
        <path d="M0 280 H400" />
      </svg>
      <svg class="quadro" data-i="1" viewBox="0 0 400 300">
        <path d="M0 250 C 120 230, 280 230, 400 250" />
        <path d="M170 300 C 185 260, 195 240, 200 230 M230 300 C 215 260, 205 240, 200 230" />
        <path d="M80 240 V170" /><circle cx="80" cy="145" r="34" /><path d="M66 160 l14 12 l14 -14" />
        <path d="M320 238 V180" /><circle cx="320" cy="158" r="26" />
        <path d="M250 236 v-14 h40 v14 M245 222 l10 -18 h30 l10 18" />
        <path d="M120 80 c8 -6 16 -6 22 0 c6 -6 14 -6 22 0" class="uccello" />
      </svg>
      <svg class="quadro" data-i="2" viewBox="0 0 400 300">
        <rect x="150" y="40" width="100" height="90" rx="3" /><path d="M200 40 V130 M150 85 H250" />
        <path d="M60 270 V200 H340 V270" /><path d="M60 225 H340" />
        <path d="M80 200 V150 c0 -10 6 -14 16 -14 h208 c10 0 16 4 16 14 v50" />
        <rect x="104" y="172" width="80" height="24" rx="10" /><rect x="216" y="172" width="80" height="24" rx="10" />
        <path d="M40 270 H360" />
      </svg>
      <svg class="quadro" data-i="3" viewBox="0 0 400 300">
        <path d="M40 60 H360 M60 60 V40 M340 60 V40 M100 60 c0 30 40 30 40 0 M180 60 c0 30 40 30 40 0 M260 60 c0 30 40 30 40 0" />
        <path d="M70 200 H330 M90 200 V280 M310 200 V280" />
        <path d="M150 160 h50 v16 c0 14 -10 22 -25 22 s-25 -8 -25 -22 z" /><path d="M200 166 c14 0 14 18 0 18" />
        <path d="M162 148 c-4 -6 4 -10 0 -16 M176 148 c-4 -6 4 -10 0 -16 M190 148 c-4 -6 4 -10 0 -16" />
        <path d="M230 198 c0 -18 10 -28 24 -28 s24 10 24 28 z" /><path d="M240 182 h28" />
      </svg>
    </div>

    <div class="testi">
      {
        tappe.map((t, i) => (
          <div class="testo" data-i={i}>
            <span class="testo-n">{t.n} / 04</span>
            <h2>{t.titolo}</h2>
            <p>{t.testo}</p>
            {i === 3 && <a class="btn" href={link(tema, 'disponibilita')}>Ora scegli le date</a>}
          </div>
        ))
      }
    </div>

    <div class="avanzamento" aria-hidden="true">
      <span class="barra"></span>
      {tappe.map((t, i) => <button type="button" data-salta={i} tabindex="-1">{t.titolo}</button>)}
    </div>
  </div>
</section>

<section class="sezione contenitore">
  <span class="occhiello">Benvenuto dentro</span>
  <h2>Scegli la tua stanza</h2>
  <div class="griglia camere">{CAMERE.map((c) => <SchedaCamera camera={c} tema={tema} class="rivela" />)}</div>
</section>

<section class="sezione cal-sez">
  <div class="contenitore">
    <h2>E poi, le date</h2>
    <Calendario tema={tema} />
  </div>
</section>

<BloccoContatti tema={tema} />

<script>
  const sez = document.querySelector<HTMLElement>('[data-percorso]');
  if (sez) {
    const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = 4;
    const aggiorna = () => {
      const r = sez.getBoundingClientRect();
      const tot = sez.offsetHeight - innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / tot));
      const pos = p * (N - 1); // 0..3 continuo
      sez.style.setProperty('--p', p.toFixed(4));
      sez.querySelectorAll<HTMLElement>('[data-i]').forEach((el) => {
        const d = Number(el.dataset.i) - pos; // <0 passato, >0 futuro
        const dd = ridotto ? Math.round(d) : d;
        el.style.setProperty('--d', dd.toFixed(3));
        el.style.setProperty('--a', Math.abs(dd).toFixed(3));
        el.classList.toggle('attivo', Math.abs(d) < 0.5);
      });
    };
    aggiorna();
    addEventListener('scroll', () => requestAnimationFrame(aggiorna), { passive: true });
    addEventListener('resize', aggiorna);
    sez.querySelectorAll<HTMLButtonElement>('[data-salta]').forEach((b) =>
      b.addEventListener('click', () => {
        const tot = sez.offsetHeight - innerHeight;
        scrollTo({ top: sez.offsetTop + (tot * Number(b.dataset.salta)) / (N - 1), behavior: 'smooth' });
      }),
    );
  }
</script>

<style>
  .percorso {
    height: 420vh;
    position: relative;
    --p: 0;
  }
  .percorso-fisso {
    position: sticky;
    top: 72px;
    height: calc(100vh - 72px);
    height: calc(100svh - 72px);
    overflow: hidden;
    display: grid;
  }
  .sfondo {
    position: absolute;
    inset: 0;
    opacity: clamp(0, 1 - var(--a, 0), 1);
  }
  .quadri {
    position: absolute;
    inset: 4% 0 38% 0;
    display: grid;
    place-items: center;
  }
  @media (min-width: 900px) {
    .quadri {
      inset: 6% 42% 6% 4%;
    }
  }
  .quadro {
    position: absolute;
    width: min(560px, 92%);
    max-height: 100%;
    fill: none;
    stroke: var(--bordeaux);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* passati: ingranditi come se ci passassi attraverso; futuri: piccoli e lontani */
    transform: scale(calc(1 - var(--d, 0) * 0.25 + max(0, var(--d, 0) * -1) * 0.9));
    opacity: clamp(0, 1 - var(--a, 0) * 1.4, 1);
    will-change: transform, opacity;
  }
  .anta-sx {
    transform-origin: 66px 200px;
    transform: perspective(600px) rotateY(calc(clamp(0, var(--p) * 6, 1) * -70deg));
  }
  .anta-dx {
    transform-origin: 334px 200px;
    transform: perspective(600px) rotateY(calc(clamp(0, var(--p) * 6, 1) * 70deg));
  }
  .targa {
    fill: var(--avorio);
  }
  .targa-t {
    font: 600 9px var(--sans);
    letter-spacing: 1.5px;
    fill: var(--bordeaux);
    stroke: none;
  }
  .uccello {
    stroke: var(--oro);
    animation: vola 3s ease-in-out infinite;
  }
  @keyframes vola {
    50% {
      transform: translate(10px, -6px);
    }
  }
  .testi {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 76px;
  }
  @media (min-width: 900px) {
    .testi {
      left: 58%;
      right: 6%;
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }
  }
  .testo {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    opacity: clamp(0, 1 - var(--a, 0) * 2, 1);
    transform: translateY(calc(var(--d, 0) * 40px));
    pointer-events: none;
  }
  @media (min-width: 900px) {
    .testo {
      top: 50%;
      bottom: auto;
      transform: translateY(calc(-50% + var(--d, 0) * 60px));
    }
  }
  .testo.attivo {
    pointer-events: auto;
  }
  .testo-n {
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    color: var(--bordeaux);
  }
  .testo h2 {
    font-size: clamp(2.2rem, 5vw, 4rem);
    margin: 6px 0 10px;
  }
  .testo p {
    font-size: 1.08rem;
    max-width: 38ch;
  }
  .avanzamento {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 22px;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    border-top: 1px solid var(--linea);
    padding-top: 8px;
  }
  .barra {
    position: absolute;
    top: -1px;
    left: 0;
    height: 2px;
    width: calc(var(--p) * 100%);
    background: var(--bordeaux);
  }
  .avanzamento button {
    background: none;
    border: 0;
    font: 400 0.74rem/1.2 var(--sans);
    color: var(--tenue);
    cursor: pointer;
    padding: 4px 0;
  }
  .camere {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin-top: 24px;
  }
  .cal-sez {
    background: var(--salvia-chiara);
  }
</style>
