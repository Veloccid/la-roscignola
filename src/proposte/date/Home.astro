---
import Foto from '../../components/Foto.astro';
import Calendario from '../../components/Calendario.astro';
import BloccoContatti from '../../components/BloccoContatti.astro';
import { CAMERE, SERVIZI_CASA } from '../../data/camere';
import { SITO } from '../../config';
import { link } from '../../temi';
const { tema } = Astro.props;
---

<section class="apertura">
  <div class="contenitore">
    <div class="apertura-testa">
      <div>
        <span class="occhiello">La Roscignola · Bed & Breakfast</span>
        <h1>Quando arrivi?</h1>
      </div>
      <ul class="garanzie">
        <li>Calendario aggiornato con Airbnb e Booking</li>
        <li>Pagamento sicuro online</li>
        <li>Miglior prezzo prenotando qui</li>
      </ul>
    </div>
    <Calendario tema={tema} class="cal-grande" />
  </div>
</section>

<section class="sezione contenitore">
  <h2>Le quattro camere</h2>
  <div class="striscia">
    {
      CAMERE.map((c) => (
        <a class="mini rivela" href={`${link(tema, 'disponibilita')}?camera=${c.id}`}>
          <Foto soggetto={c.nome} tipo="camera" tinta={c.tinta} rapporto="1 / 1" etichetta={false} />
          <div>
            <b>{c.nome}</b>
            <span>{c.ospiti} ospiti · da {c.prezzo}€</span>
          </div>
        </a>
      ))
    }
  </div>
  <p class="tutte"><a href={link(tema, 'camere')}>Foto e dettagli delle camere →</a></p>
</section>

<section class="sezione info">
  <div class="contenitore info-griglia">
    {SERVIZI_CASA.map((s) => (
      <div><h3>{s.titolo}</h3><p class="tenue">{s.testo}</p></div>
    ))}
    <div><h3>Orari</h3><p class="tenue">Check‑in {SITO.checkin}. Check‑out {SITO.checkout}.</p></div>
  </div>
</section>

<BloccoContatti tema={tema} />

<style>
  .apertura {
    background: linear-gradient(180deg, var(--sabbia) 0 62%, var(--avorio) 62%);
    padding-block: clamp(28px, 5vw, 64px) 24px;
  }
  .apertura-testa {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 40px;
    margin-bottom: 24px;
  }
  .apertura h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    margin: 0;
    color: var(--bordeaux);
  }
  .garanzie {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
    font-size: 0.92rem;
  }
  .garanzie li::before {
    content: '✓';
    color: var(--salvia);
    font-weight: 600;
    margin-right: 8px;
  }
  .apertura :global(.cal-grande) {
    box-shadow: 0 30px 60px -30px rgba(90, 21, 32, 0.45);
  }
  .striscia {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    margin-top: 20px;
  }
  .mini {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 14px;
    align-items: center;
    padding: 10px;
    border-radius: 16px;
    background: var(--superficie);
    border: 1px solid var(--linea);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .mini:hover {
    border-color: var(--bordeaux);
    transform: translateY(-2px);
  }
  .mini :global(.foto) {
    --raggio-foto: 10px;
  }
  .mini b {
    display: block;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.2rem;
  }
  .mini span {
    font-size: 0.84rem;
    color: var(--tenue);
  }
  .tutte a {
    color: var(--bordeaux);
  }
  .info {
    background: var(--superficie);
    border-top: 1px solid var(--linea);
  }
  .info-griglia {
    display: grid;
    gap: 28px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .info h3 {
    font-size: 1.2rem;
    color: var(--bordeaux);
  }
</style>
