---
import Foto from '../../components/Foto.astro';
import Calendario from '../../components/Calendario.astro';
import BloccoContatti from '../../components/BloccoContatti.astro';
import { CAMERE } from '../../data/camere';
import { link } from '../../temi';
const { tema } = Astro.props;
---

<section class="bacheca-sez">
  <div class="contenitore">
    <div class="testa">
      <span class="occhiello">Reception</span>
      <h1>Scegli la tua chiave</h1>
      <p class="tenue">Ogni chiave apre una stanza. Toccala per girare la targhetta.</p>
    </div>
    <div class="bacheca">
      <div class="asse" aria-hidden="true"></div>
      {
        CAMERE.map((c, i) => (
          <div class="chiave" style={`--i:${i}`}>
            <span class="gancio" aria-hidden="true"></span>
            <div class="oscilla">
              <svg class="ferro" viewBox="0 0 60 150" aria-hidden="true">
                <circle cx="30" cy="22" r="16" />
                <circle cx="30" cy="22" r="7" class="buco" />
                <path d="M30 38 V128 M30 104 h14 M30 118 h10 M30 128 h12" />
              </svg>
              <button type="button" class="targa" aria-expanded="false" aria-label={`Gira la targhetta: ${c.nome}`}>
                <span class="faccia fronte">
                  <span class="num">{i + 1}</span>
                  <span class="nome">{c.nome.replace('Camera ', '').replace('Suite ', '')}</span>
                  <span class="gira">gira ↻</span>
                </span>
                <span class="faccia retro">
                  <b>{c.nome}</b>
                  <span>{c.letti}</span>
                  <span>fino a {c.ospiti} ospiti · {c.mq} m²</span>
                  <span class="prezzo">da {c.prezzo}€</span>
                </span>
              </button>
            </div>
            <a class="prenota" href={`${link(tema, 'disponibilita')}?camera=${c.id}`}>Date libere →</a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="sezione contenitore stanze">
  {
    CAMERE.map((c, i) => (
      <article class="stanza rivela">
        <Foto soggetto={c.nome} tipo="camera" tinta={c.tinta} src={c.foto} rapporto="4 / 3" />
        <div>
          <span class="tag">Chiave n. {i + 1}</span>
          <h3>{c.nome}</h3>
          <p class="tenue">{c.descrizione}</p>
        </div>
      </article>
    ))
  }
</section>

<section class="sezione cal-sez">
  <div class="contenitore">
    <h2>Le chiavi libere, giorno per giorno</h2>
    <Calendario tema={tema} />
  </div>
</section>

<BloccoContatti tema={tema} />

<script>
  document.querySelectorAll<HTMLButtonElement>('.targa').forEach((t) =>
    t.addEventListener('click', () => {
      const girata = t.classList.toggle('girata');
      t.setAttribute('aria-expanded', String(girata));
    }),
  );
</script>

<style>
  .bacheca-sez {
    background:
      radial-gradient(70% 60% at 50% 0%, rgba(180, 143, 90, 0.18), transparent 70%),
      var(--avorio);
    padding-block: clamp(36px, 6vw, 80px);
  }
  .testa {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 36px;
  }
  .bacheca {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 36px 12px;
    padding: 40px 12px 28px;
    border-radius: 18px;
    background: linear-gradient(180deg, #5c1814, var(--bordeaux-scuro));
    box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.08), 0 30px 60px -30px rgba(42, 28, 25, 0.6);
    max-width: 920px;
    margin-inline: auto;
  }
  @media (min-width: 760px) {
    .bacheca {
      grid-template-columns: repeat(4, 1fr);
      padding: 46px 24px 36px;
    }
  }
  .asse {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 22px;
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(180deg, #d8b679, #9c7740);
  }
  @media (max-width: 759px) {
    .asse {
      display: none;
    }
  }
  .chiave {
    display: grid;
    justify-items: center;
    position: relative;
  }
  .gancio {
    width: 10px;
    height: 16px;
    border: 3px solid #d8b679;
    border-top: 0;
    border-radius: 0 0 8px 8px;
    margin-bottom: -6px;
    z-index: 2;
  }
  .oscilla {
    display: grid;
    justify-items: center;
    transform-origin: 50% 0;
    animation: dondola 4.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.1s);
  }
  .chiave:hover .oscilla {
    animation-duration: 1.6s;
  }
  @keyframes dondola {
    0%,
    100% {
      transform: rotate(-2.5deg);
    }
    50% {
      transform: rotate(2.5deg);
    }
  }
  .ferro {
    width: 44px;
    fill: none;
    stroke: #d8b679;
    stroke-width: 5;
    stroke-linecap: round;
    margin-bottom: -40px;
    position: relative;
    z-index: 1;
  }
  .ferro .buco {
    stroke-width: 3;
  }
  .targa {
    position: relative;
    width: min(150px, 38vw);
    aspect-ratio: 3 / 4;
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
    perspective: 800px;
    margin-top: 40px;
    font: inherit;
  }
  .faccia {
    position: absolute;
    inset: 0;
    border-radius: 40% 40% 14px 14px / 22% 22% 14px 14px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 4px;
    padding: 14px 10px;
    text-align: center;
    box-shadow: 0 10px 20px -8px rgba(0, 0, 0, 0.5);
  }
  .fronte {
    background: linear-gradient(160deg, #e9cf9c, #b48f5a 60%, #8f6b38);
    color: var(--bordeaux-scuro);
  }
  .fronte::before {
    content: '';
    position: absolute;
    top: 10px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bordeaux-scuro);
    box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.5);
  }
  .num {
    font-family: var(--serif);
    font-size: 2.6rem;
    line-height: 1;
  }
  .nome {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
  }
  .gira {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-top: 6px;
  }
  .retro {
    background: var(--avorio);
    color: var(--testo);
    transform: rotateY(180deg);
    font-size: 0.78rem;
    line-height: 1.3;
  }
  .retro b {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--bordeaux);
  }
  .retro .prezzo {
    font-family: var(--serif);
    font-size: 1.3rem;
    color: var(--bordeaux);
    margin-top: 4px;
  }
  .girata .fronte {
    transform: rotateY(-180deg);
  }
  .girata .retro {
    transform: rotateY(0);
  }
  .prenota {
    margin-top: 14px;
    color: var(--avorio);
    font-size: 0.85rem;
    font-weight: 500;
  }
  .stanze {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .tag {
    display: inline-block;
    margin-top: 14px;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oro);
  }
  .stanza h3 {
    margin-top: 4px;
  }
  .cal-sez {
    background: var(--sabbia);
  }
</style>
